# PostgreSQL connection string used by the application and seed script.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Use a random value of at least 32 characters in every non-development environment.
AUTH_SECRET=replace-with-a-random-32-character-secret

# Optional: used by Ask St Mark's for retrieval-grounded answers.
OPENAI_API_KEY=

# Optional: used for canonical metadata URLs.
NEXT_PUBLIC_SITE_URL=https://example.org

# Optional seed overrides. Never use the demo defaults in production.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-admin-password
