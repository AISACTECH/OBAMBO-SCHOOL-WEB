# PostgreSQL connection string used by the application and seed script.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Use a random value of at least 32 characters in every non-development environment.
AUTH_SECRET=replace-with-a-random-32-character-secret

# Optional: used by Ask St Mark's for retrieval-grounded answers.
OPENAI_API_KEY=

# Google Sheets integration. Keep this disabled until the OAuth redirect URI is configured.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.org/api/admin/google-sheets/callback
# Use a random 32-byte key encoded as 64 hexadecimal characters in production.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional comma-separated override for least-privilege scopes.
# GOOGLE_SHEETS_SCOPES=openid,email,https://www.googleapis.com/auth/spreadsheets.readonly

# Optional: used for canonical metadata URLs.
NEXT_PUBLIC_SITE_URL=https://example.org

# Optional seed overrides. Never use the demo defaults in production.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-admin-password
